general {
    colors = true
    interval = 5
}

order += "external_script weather"
order += "battery 0"
order += "path_exists uni-qis"
order += "path_exists uk-edi"
order += "ethernet _first_"
order += "wireless _first_"
order += "disk /"
order += "cpu_usage"
order += "memory"
order += "tztime date"
order += "tztime phoenix"
order += "tztime canada"
order += "tztime asu"
order += "tztime local"

external_script weather {
    format = "{output}"
    script_path = "$HOME/repository/bash-collection/weather-anonymous"
    cache_timeout = 300
}

battery 0 {
    format = "%status %percentage (%emptytime %consumption)"
    format_down = ""
    status_chr = "🔌CHR"
    status_bat = "BAT"
    status_unk = "UNK"
    status_full = "🔋FULL"
    low_threshold = "25"
    threshold_type = "percentage"
    format_percentage = "%.02f%s"
}

path_exists uni-qis {
    path = "/proc/sys/net/ipv4/conf/wgtuk-Full-Arch"
    format_down = ""
}

path_exists uk-edi {
    path = "/proc/sys/net/ipv4/conf/uk-edi"
    format_down = ""
}

ethernet _first_ {
    format_up = "E: (%speed)"
    format_down = ""
}

wireless _first_ {
    format_up = "W:%quality @ %bitrate, %frequency"
    format_down = ""
}

disk "/" {
    format = "free: %avail"
}

cpu_usage {
    format = "CPU: %usage"
}

memory {
    format = "MEM: %used/%available"
    threshold_degraded = "1G"
    format_degraded = "MEMORY < %available"
}

tztime date {
    format = "%d.%m.%Y"
}

tztime phoenix {
    timezone = "America/Phoenix"
    format = "🐦‍🔥: %H:%M"
}

tztime canada {
    timezone = "America/Toronto"
    format = "🇨🇦: %H:%M"
}

tztime asu {
    timezone = "America/Asuncion"
    format = "🇵🇾: %H:%M"
}

tztime local {
    timezone = "Europe/Berlin"
    format = "🇩🇪: %H:%M"
}
